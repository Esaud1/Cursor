@page
@model WComtismc.Pages.Cart.IndexModel
@inject WComtismc.Services.ICartService CartService
@{
    ViewData["Title"] = "سلة التسوق";
    var items = CartService.GetItems();
}

<div class="inner-page">
    <div class="container">
        <div class="section-label">سلة التسوق</div>
        <h1 class="section-title">مشترياتك</h1>

        @if (items.Count == 0)
        {
            <div class="empty-lux">
                <span class="empty-lux-icon">🛍</span>
                <h3>سلتك فارغة</h3>
                <p>اكتشفي مجموعتنا الفاخرة من منتجات التجميل</p>
                <a asp-page="/Products/Index" class="btn-lux">تسوقي الآن</a>
            </div>
        }
        else
        {
            <div class="checkout-layout">
                <div class="panel-lux">
                    @foreach (var item in items)
                    {
                        <div class="cart-lux-item">
                            <img src="@item.ImageUrl" alt="@item.Name" />
                            <div class="cart-lux-info">
                                <h3>@item.Name</h3>
                                <span class="lux-price">@item.Price.ToString("0.##") ر.س</span>
                            </div>
                            <form method="post" asp-page-handler="Update" class="cart-lux-qty">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" class="input-lux input-lux-sm" onchange="this.form.submit()" />
                            </form>
                            <span class="lux-price">@item.Total.ToString("0.##") ر.س</span>
                            <form method="post" asp-page-handler="Remove">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="btn-remove">✕</button>
                            </form>
                        </div>
                    }
                    <form method="post" asp-page-handler="Clear" class="mt-3">
                        <button type="submit" class="link-muted">إفراغ السلة</button>
                    </form>
                </div>
                <div class="panel-lux panel-summary">
                    <h3>ملخص الطلب</h3>
                    <div class="summary-line"><span>المجموع</span><span>@Model.Subtotal.ToString("0.##") ر.س</span></div>
                    <div class="summary-line"><span>الشحن</span><span>@(Model.Shipping == 0 ? "مجاني" : $"{Model.Shipping:0.##} ر.س")</span></div>
                    @if (Model.Subtotal > 0 && Model.Subtotal < 300)
                    {
                        <p class="hint-gold">أضيفي @((300 - Model.Subtotal).ToString("0.##")) ر.س للشحن المجاني</p>
                    }
                    <div class="summary-line summary-total"><span>الإجمالي</span><span>@Model.Total.ToString("0.##") ر.س</span></div>
                    <a asp-page="/Checkout/Index" class="btn-lux w-100 mt-3">إتمام الشراء</a>
                    <a asp-page="/Products/Index" class="btn-lux-ghost w-100 mt-2">متابعة التسوق</a>
                </div>
            </div>
        }
    </div>
</div>
