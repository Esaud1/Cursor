@page
@model WComtismc.Pages.Cart.IndexModel
@inject WComtismc.Services.ICartService CartService
@{
    ViewData["Title"] = "سلة التسوق";
    var items = CartService.GetItems();
}

<div class="container store-page">
    <h1 class="page-title-store">سلة التسوق</h1>

    @if (items.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">🛒</div>
            <h2>سلتك فارغة</h2>
            <p>أضيفي منتجات التجميل المفضلة لديك</p>
            <a asp-page="/Products/Index" class="btn btn-store">تسوقي الآن</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="cart-table-card">
                    @foreach (var item in items)
                    {
                        <div class="cart-item">
                            <img src="@item.ImageUrl" alt="@item.Name" class="cart-item-image" />
                            <div class="cart-item-info">
                                <h3 class="cart-item-name">@item.Name</h3>
                                <span class="cart-item-price">@item.Price.ToString("0.##") ر.س</span>
                            </div>
                            <form method="post" asp-page-handler="Update" class="cart-quantity-form">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm" onchange="this.form.submit()" />
                            </form>
                            <span class="cart-item-total">@item.Total.ToString("0.##") ر.س</span>
                            <form method="post" asp-page-handler="Remove">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="btn btn-link text-danger p-0">✕</button>
                            </form>
                        </div>
                    }
                </div>
                <form method="post" asp-page-handler="Clear" class="mt-2">
                    <button type="submit" class="btn btn-link text-muted">إفراغ السلة</button>
                </form>
            </div>
            <div class="col-lg-4">
                <div class="order-summary-card">
                    <h3>ملخص الطلب</h3>
                    <div class="summary-row">
                        <span>المجموع الفرعي</span>
                        <span>@Model.Subtotal.ToString("0.##") ر.س</span>
                    </div>
                    <div class="summary-row">
                        <span>الشحن</span>
                        <span>@(Model.Shipping == 0 ? "مجاني" : $"{Model.Shipping:0.##} ر.س")</span>
                    </div>
                    @if (Model.Subtotal > 0 && Model.Subtotal < 300)
                    {
                        <p class="shipping-hint">أضيفي منتجات بقيمة @((300 - Model.Subtotal).ToString("0.##")) ر.س للشحن المجاني</p>
                    }
                    <div class="summary-row summary-total">
                        <span>الإجمالي</span>
                        <span>@Model.Total.ToString("0.##") ر.س</span>
                    </div>
                    <a asp-page="/Checkout/Index" class="btn btn-store w-100 mt-3">إتمام الشراء</a>
                    <a asp-page="/Products/Index" class="btn btn-outline-store w-100 mt-2">متابعة التسوق</a>
                </div>
            </div>
        </div>
    }
</div>
