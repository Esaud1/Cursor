@page
@model WComtismc.Pages.Orders.MyOrdersModel
@using WComtismc.Helpers
@{
    ViewData["Title"] = "طلباتي";
}

<div class="container store-page">
    <h1 class="page-title-store">طلباتي</h1>

    @if (Model.Orders.Count == 0)
    {
        <div class="empty-state">
            <p>لا توجد طلبات سابقة.</p>
            <a asp-page="/Products/Index" class="btn btn-store">ابدئي التسوق</a>
        </div>
    }
    else
    {
        @foreach (var order in Model.Orders)
        {
            <div class="order-card">
                <div class="order-card-header">
                    <div>
                        <strong>طلب #@order.Id.ToString()[..8].ToUpper()</strong>
                        <span class="text-muted small" dir="ltr">@order.CreatedAt.ToString("yyyy/MM/dd hh:mm tt")</span>
                    </div>
                    <span class="order-status-badge">@StoreLabels.GetStatusLabel(order.Status)</span>
                </div>
                <div class="order-card-items">
                    @foreach (var item in order.Items)
                    {
                        <span>@item.Name × @item.Quantity</span>
                    }
                </div>
                <div class="order-card-footer">
                    <strong>@order.Total.ToString("0.##") ر.س</strong>
                    <a asp-page="/Orders/Confirmation" asp-route-id="@order.Id" class="btn btn-sm btn-outline-store">التفاصيل</a>
                </div>
            </div>
        }
    }
</div>
