@page
@model WComtismc.Pages.Account.LoginModel
@{
    ViewData["Title"] = "تسجيل الدخول";
}

<div class="inner-page">
    <div class="container">
        <div class="auth-lux">
            <div class="section-label">حسابي</div>
            <h1 class="section-title">تسجيل الدخول</h1>
            <p class="auth-lead">مرحباً بعودتك إلى W Cosmatic</p>

            <form method="post" class="panel-lux">
                <div asp-validation-summary="ModelOnly" class="alert-lux alert-danger"></div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email" class="input-lux" dir="ltr" />
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <input asp-for="Input.Password" class="input-lux" />
                    <span asp-validation-for="Input.Password" class="field-error"></span>
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <label asp-for="Input.RememberMe" class="form-check-label"></label>
                </div>
                <button type="submit" class="btn-lux w-100">دخول</button>
            </form>
            <p class="auth-foot">ليس لديك حساب؟ <a asp-page="/Account/Register" class="link-gold">سجّلي الآن</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
