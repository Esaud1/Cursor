@page "{id:guid}"
@model WComtismc.Pages.Products.DetailsModel
@{
    ViewData["Title"] = Model.Product.NameAr;
}

<div class="detail-page">
    <div class="container">
        <nav class="lux-breadcrumb">
            <a asp-page="/Index">الرئيسية</a> ·
            <a asp-page="/Products/Index">المتجر</a> ·
            <span>@Model.Product.NameAr</span>
        </nav>

        <div class="detail-layout">
            <div class="detail-gallery">
                <img src="@Model.Product.ImageUrl" alt="@Model.Product.NameAr" />
                @if (Model.Product.DiscountPercent > 0)
                {
                    <span class="lux-tag lux-tag-sale detail-tag">-@Model.Product.DiscountPercent%</span>
                }
            </div>
            <div class="detail-panel">
                <span class="lux-brand">@Model.Product.Brand</span>
                <h1 class="detail-title">@Model.Product.NameAr</h1>
                <div class="detail-rating">★ @Model.Product.Rating.ToString("0.0") <span>/ 5</span></div>
                <div class="detail-prices">
                    <span class="lux-price lux-price-lg">@Model.Product.Price.ToString("0.##") ر.س</span>
                    @if (Model.Product.OldPrice is > 0)
                    {
                        <span class="lux-old-price">@Model.Product.OldPrice.Value.ToString("0.##") ر.س</span>
                    }
                </div>
                <p class="detail-desc">@Model.Product.Description</p>
                <div class="detail-specs">
                    <div><span>التصنيف</span><strong>@Model.Product.Category</strong></div>
                    <div><span>الماركة</span><strong>@Model.Product.Brand</strong></div>
                    <div><span>المتوفر</span><strong>@(Model.Product.Stock > 0 ? $"{Model.Product.Stock} قطعة" : "نفد")</strong></div>
                </div>
                @if (Model.Product.Stock > 0)
                {
                    <form method="post" asp-page-handler="AddToCart" class="detail-form">
                        <input type="hidden" name="id" value="@Model.Product.Id" />
                        <div class="qty-field">
                            <label>الكمية</label>
                            <input type="number" name="quantity" value="1" min="1" max="@Model.Product.Stock" class="input-lux" />
                        </div>
                        <button type="submit" class="btn-lux btn-lux-lg w-100">أضف إلى السلة</button>
                    </form>
                }
                else
                {
                    <button class="btn-lux btn-lux-lg w-100" disabled>نفدت الكمية</button>
                }
            </div>
        </div>

        @if (Model.RelatedProducts.Count > 0)
        {
            <section class="lux-section mt-5">
                <div class="section-label">قد يعجبك</div>
                <h2 class="section-title">منتجات مشابهة</h2>
                <div class="lux-grid">
                    @foreach (var product in Model.RelatedProducts)
                    {
                        <partial name="_ProductCard" model="product" />
                    }
                </div>
            </section>
        }
    </div>
</div>
