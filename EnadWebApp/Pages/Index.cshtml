@page
@model IndexModel
@{
    ViewData["Title"] = "الرئيسية";
}

<div class="text-center">
    <h1 class="display-4 text-success">Enad Web APP</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <p class="lead">مرحباً بعودتك، @User.Identity.Name!</p>
    }
    else
    {
        <p class="lead">يرجى <a asp-page="/Account/Login">تسجيل الدخول</a> للمتابعة.</p>
    }
</div>
